+type e2eBridgeOpener struct{ stream io.ReadWriteCloser }
+
+func (o e2eBridgeOpener) OpenStream(context.Context, relay.StreamRequest) (io.ReadWriteCloser, error) {
+	return o.stream, nil
+}
+func (o e2eBridgeOpener) Close() error { return nil }
