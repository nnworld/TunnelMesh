[Unit]
Description=TunnelMesh Server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tunnelmesh
Group=tunnelmesh
WorkingDirectory=/var/lib/tunnelmesh
# 密钥只能通过环境注入。文件由运维创建，权限 0640 root:tunnelmesh，不进版本库。
# 前缀 - 表示文件缺失时不阻塞启动：本地模式不需要主密钥也能运行。
EnvironmentFile=-/etc/tunnelmesh/server.env
ExecStartPre=+/usr/local/bin/tunnelmesh-server --config /etc/tunnelmesh/server.yaml init-node-id
ExecStartPre=/usr/local/bin/tunnelmesh-server --config /etc/tunnelmesh/server.yaml check-config
ExecStart=/usr/local/bin/tunnelmesh-server --config /etc/tunnelmesh/server.yaml run
# 长驻服务不以退出码表达意图：入口返回 0 同样可能只是监听器被意外关掉，所以任何自行退出都要拉起。
Restart=always
RestartSec=5s
# 78 是配置错误，77 是凭据被永久拒绝：重启修不好它们，不应被 systemd 无限拉起。
# 同一份契约也覆盖 ExecStartPre 的 check-config——它现在同样以 78 退出。
RestartPreventExitStatus=78 77
# 优雅停机上界：HTTP drain 5s + server.vpn.shutdown_timeout（默认 15s），再留裕量。
TimeoutStopSec=60s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tunnelmesh
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
