[Unit]
Description=TunnelMesh Agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tunnelmesh
Group=tunnelmesh
WorkingDirectory=/var/lib/tunnelmesh-agent
# agent.token 的 YAML 键是 `yaml:"-"`，只能通过环境变量注入；
# 前缀 `-` 表示文件缺失时不阻塞启动，与 server 单元保持一致。
EnvironmentFile=-/etc/tunnelmesh/agent.env
ExecStartPre=/usr/local/bin/tunnelmesh-agent --config /etc/tunnelmesh/agent.yaml check-config
ExecStart=/usr/local/bin/tunnelmesh-agent --config /etc/tunnelmesh/agent.yaml run
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=false
ProtectSystem=strict
ReadWritePaths=/var/lib/tunnelmesh-agent
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
