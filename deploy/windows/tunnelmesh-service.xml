<?xml version="1.0" encoding="UTF-8"?>
<!--
  WinSW 服务模板，由 deploy\install\windows-install.ps1 渲染，
  server / agent / client 三个角色共用同一份文件。
  占位符：__ROLE__、__ROLE_TITLE__、__BINARY__、__CONFIG__、__INSTALL_DIR__。
  不要把 Token 或密码写进本文件；配置路径由 -Config 传入，日志固定在
  __INSTALL_DIR__\logs，与 docs/deployment/windows-service.md 保持一致。
-->
<service>
  <id>tunnelmesh-__ROLE__</id>
  <name>TunnelMesh __ROLE_TITLE__</name>
  <description>TunnelMesh __ROLE__ service</description>
  <executable>__BINARY__</executable>
  <arguments>--config &quot;__CONFIG__&quot; run</arguments>
  <workingdirectory>__INSTALL_DIR__</workingdirectory>
  <logpath>__INSTALL_DIR__\logs</logpath>
  <log mode="roll-by-size" />
  <onfailure action="restart" delay="5 sec" />
</service>
