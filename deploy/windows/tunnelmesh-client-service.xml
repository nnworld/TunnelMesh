<service>
  <id>tunnelmesh-client</id>
  <name>TunnelMesh Client</name>
  <description>TunnelMesh client local proxy service</description>
  <executable>tunnelmesh-client.exe</executable>
  <arguments>--config "C:\ProgramData\TunnelMesh\client.yaml" run</arguments>
  <workingdirectory>C:\ProgramData\TunnelMesh</workingdirectory>
  <logpath>C:\ProgramData\TunnelMesh\logs</logpath>
  <log mode="roll-by-size" />
  <onfailure action="restart" delay="5 sec" />
</service>
