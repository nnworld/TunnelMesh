{
  "uid": "tunnelmesh-overview",
  "title": "TunnelMesh",
  "description": "Unified TunnelMesh control-plane, agent, network, cluster, and security observability.",
  "__inputs": [{"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus"}],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "30s",
  "timezone": "browser",
  "templating": {
    "list": [
      {"name": "cluster", "label": "Cluster", "type": "query", "query": "label_values(tunnelmesh_ready, cluster)", "datasource": "${DS_PROMETHEUS}", "includeAll": true, "allValue": ".*", "multi": true, "refresh": 2, "current": {"text": "All", "value": "$__all"}},
      {"name": "node_id", "label": "Node", "type": "query", "query": "label_values(tunnelmesh_ready, node_id)", "datasource": "${DS_PROMETHEUS}", "includeAll": true, "allValue": ".*", "multi": true, "refresh": 2, "current": {"text": "All", "value": "$__all"}},
      {"name": "component", "label": "Component", "type": "query", "query": "label_values(tunnelmesh_connections_active, component)", "datasource": "${DS_PROMETHEUS}", "includeAll": true, "allValue": ".*", "multi": true, "refresh": 2, "current": {"text": "All", "value": "$__all"}},
      {"name": "agent_id", "label": "Agent", "type": "query", "query": "label_values(tunnelmesh_agent_connections, agent_id)", "datasource": "${DS_PROMETHEUS}", "includeAll": true, "allValue": ".*", "multi": true, "refresh": 2, "current": {"text": "All", "value": "$__all"}}
    ]
  },
  "annotations": {"list": []},
  "panels": [
    {"type": "row", "title": "Overview", "collapsed": false, "panels": [
      {"type": "stat", "title": "Readiness", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "min by (node_id) (tunnelmesh_ready{cluster=~\"$cluster\", node_id=~\"$node_id\"})", "refId": "A"}], "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}},
      {"type": "timeseries", "title": "Active connections", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "sum by (component) (tunnelmesh_connections_active{cluster=~\"$cluster\", node_id=~\"$node_id\", component=~\"$component\"})", "refId": "A"}], "gridPos": {"h": 8, "w": 9, "x": 6, "y": 0}},
      {"type": "timeseries", "title": "Throughput", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "sum by (direction, protocol) (rate(tunnelmesh_bytes_total{cluster=~\"$cluster\", node_id=~\"$node_id\", component=~\"$component\"}[5m]))", "refId": "A"}], "gridPos": {"h": 8, "w": 9, "x": 15, "y": 0}},
      {"type": "timeseries", "title": "Connection error rate", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "sum(rate(tunnelmesh_connections_total{cluster=~\"$cluster\", node_id=~\"$node_id\", result=~\"failed|error\"}[5m])) / clamp_min(sum(rate(tunnelmesh_connections_total{cluster=~\"$cluster\", node_id=~\"$node_id\"}[5m])), 1)", "refId": "A"}], "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}},
      {"type": "table", "title": "Recent probe outcomes", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "sum by (probe_kind, result, error_class) (increase(tunnelmesh_probe_total{cluster=~\"$cluster\", node_id=~\"$node_id\"}[15m]))", "refId": "A", "format": "table"}], "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}}
    ]},
    {"type": "row", "title": "Agent", "collapsed": false, "panels": [
      {"type": "stat", "title": "Active agent connections", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "sum by (node_id) (tunnelmesh_connections_active{cluster=~\"$cluster\", node_id=~\"$node_id\", component=\"agent\"})", "refId": "A"}], "gridPos": {"h": 4, "w": 6, "x": 0, "y": 16}},
      {"type": "timeseries", "title": "Agent heartbeat RTT", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "histogram_quantile(0.95, sum by (le, component) (rate(tunnelmesh_heartbeat_rtt_seconds_bucket{cluster=~\"$cluster\", node_id=~\"$node_id\", component=\"agent\"}[5m])))", "refId": "A"}], "gridPos": {"h": 8, "w": 9, "x": 6, "y": 16}},
      {"type": "timeseries", "title": "Agent heartbeat outcomes", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "sum by (result) (rate(tunnelmesh_heartbeat_total{cluster=~\"$cluster\", node_id=~\"$node_id\", component=\"agent\"}[5m]))", "refId": "A"}], "gridPos": {"h": 8, "w": 9, "x": 15, "y": 16}},
      {"type": "timeseries", "title": "Agent connection stages", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "histogram_quantile(0.95, sum by (le, stage) (rate(tunnelmesh_connection_stage_duration_seconds{cluster=~\"$cluster\", node_id=~\"$node_id\", component=\"agent\"}[5m])))", "refId": "A"}], "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24}},
      {"type": "table", "title": "Agent errors", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "sum by (result, error_class) (increase(tunnelmesh_connections_total{cluster=~\"$cluster\", node_id=~\"$node_id\", component=\"agent\", result=~\"failed|error\"}[15m]))", "refId": "A", "format": "table"}], "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}},
      {"type": "timeseries", "title": "Agent pool scale decisions", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "sum by (agent_id, instance_id, decision, reason) (rate(tunnelmesh_agent_connection_scale_decisions_total{cluster=~\"$cluster\", node_id=~\"$node_id\", agent_id=~\"$agent_id\"}[5m]))", "refId": "A"}], "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32}},
      {"type": "timeseries", "title": "Agent selection", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "sum by (agent_id, server_node_id, scope) (rate(tunnelmesh_agent_selection_total{cluster=~\"$cluster\", node_id=~\"$node_id\", agent_id=~\"$agent_id\"}[5m]))", "refId": "A"}], "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32}}
    ]},
    {"type": "row", "title": "Network", "collapsed": false, "panels": [
      {"type": "stat", "title": "Active streams", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "sum(tunnelmesh_streams_active{cluster=~\"$cluster\", node_id=~\"$node_id\"})", "refId": "A"}], "gridPos": {"h": 4, "w": 6, "x": 0, "y": 32}},
      {"type": "timeseries", "title": "Traffic by protocol", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "sum by (protocol, direction) (rate(tunnelmesh_bytes_total{cluster=~\"$cluster\", node_id=~\"$node_id\"}[5m]))", "refId": "A"}], "gridPos": {"h": 8, "w": 9, "x": 6, "y": 32}},
      {"type": "timeseries", "title": "Stream error rate", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "sum by (protocol) (rate(tunnelmesh_stream_errors_total{cluster=~\"$cluster\", node_id=~\"$node_id\"}[5m]))", "refId": "A"}], "gridPos": {"h": 8, "w": 9, "x": 15, "y": 32}},
      {"type": "timeseries", "title": "Probe latency p95", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "histogram_quantile(0.95, sum by (le, probe_kind) (rate(tunnelmesh_probe_duration_seconds_bucket{cluster=~\"$cluster\", node_id=~\"$node_id\"}[5m])))", "refId": "A"}], "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40}},
      {"type": "table", "title": "Network probe failures", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "sum by (probe_kind, error_class) (increase(tunnelmesh_probe_total{cluster=~\"$cluster\", node_id=~\"$node_id\", result=~\"failed|error|timeout\"}[15m]))", "refId": "A", "format": "table"}], "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40}},
      {"type": "timeseries", "title": "Stream open and backpressure", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "sum by (component, result, open_mode) (rate(tunnelmesh_stream_open_total{cluster=~\"$cluster\", node_id=~\"$node_id\"}[5m]))", "refId": "A"}, {"expr": "sum by (component, result) (rate(tunnelmesh_stream_backpressure_total{cluster=~\"$cluster\", node_id=~\"$node_id\"}[5m]))", "refId": "B"}], "gridPos": {"h": 8, "w": 12, "x": 0, "y": 48}},
      {"type": "timeseries", "title": "Stream stage latency p95", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "histogram_quantile(0.95, sum by (le, component, stage, result, protocol) (rate(tunnelmesh_stream_stage_duration_seconds_bucket{cluster=~\"$cluster\", node_id=~\"$node_id\"}[5m])))", "refId": "A"}], "gridPos": {"h": 8, "w": 12, "x": 12, "y": 48}},
      {"type": "timeseries", "title": "Stream queue and window stall p95", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "histogram_quantile(0.95, sum by (le, component, result) (rate(tunnelmesh_stream_queue_wait_seconds_bucket{cluster=~\"$cluster\", node_id=~\"$node_id\"}[5m])))", "refId": "A"}, {"expr": "histogram_quantile(0.95, sum by (le, component, result) (rate(tunnelmesh_stream_window_stall_seconds_bucket{cluster=~\"$cluster\", node_id=~\"$node_id\"}[5m])))", "refId": "B"}], "gridPos": {"h": 8, "w": 24, "x": 0, "y": 56}}
    ]},
    {"type": "row", "title": "Cluster", "collapsed": false, "panels": [
      {"type": "stat", "title": "Ready nodes", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "sum by (node_id) (tunnelmesh_ready{cluster=~\"$cluster\", node_id=~\"$node_id\", component=\"server\"})", "refId": "A"}], "gridPos": {"h": 4, "w": 6, "x": 0, "y": 48}},
      {"type": "timeseries", "title": "Registry lease outcomes", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "sum by (result) (rate(tunnelmesh_registry_lease_total{cluster=~\"$cluster\", node_id=~\"$node_id\"}[5m]))", "refId": "A"}], "gridPos": {"h": 8, "w": 9, "x": 6, "y": 48}},
      {"type": "timeseries", "title": "Relay outcomes", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "sum by (result) (rate(tunnelmesh_relay_total{cluster=~\"$cluster\", node_id=~\"$node_id\"}[5m]))", "refId": "A"}], "gridPos": {"h": 8, "w": 9, "x": 15, "y": 48}},
      {"type": "timeseries", "title": "Storage operation p95", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "histogram_quantile(0.95, sum by (le, operation) (rate(tunnelmesh_storage_operation_duration_seconds_bucket{cluster=~\"$cluster\", node_id=~\"$node_id\"}[5m])))", "refId": "A"}], "gridPos": {"h": 8, "w": 12, "x": 0, "y": 56}},
      {"type": "table", "title": "Cluster failures", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "sum by (component, error_class) (increase(tunnelmesh_storage_errors_total{cluster=~\"$cluster\", node_id=~\"$node_id\"}[15m]))", "refId": "A", "format": "table"}], "gridPos": {"h": 8, "w": 12, "x": 12, "y": 56}},
      {"type": "timeseries", "title": "Authorization and remote-validation cache", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "sum by (cache, result) (rate(tunnelmesh_authorization_cache_requests_total{cluster=~\"$cluster\", node_id=~\"$node_id\"}[5m]))", "refId": "A"}, {"expr": "sum by (cache, result) (rate(tunnelmesh_remote_validation_cache_requests_total{cluster=~\"$cluster\", node_id=~\"$node_id\"}[5m]))", "refId": "B"}], "gridPos": {"h": 8, "w": 12, "x": 0, "y": 64}},
      {"type": "timeseries", "title": "Authorization revision and polling", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "max(tunnelmesh_authorization_revision{cluster=~\"$cluster\", node_id=~\"$node_id\"})", "refId": "A"}, {"expr": "sum by (result, error_class) (rate(tunnelmesh_authorization_revision_poll_total{cluster=~\"$cluster\", node_id=~\"$node_id\"}[5m]))", "refId": "B"}], "gridPos": {"h": 8, "w": 12, "x": 12, "y": 64}}
    ]},
    {"type": "row", "title": "Security", "collapsed": false, "panels": [
      {"type": "stat", "title": "Auth failures", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "sum(increase(tunnelmesh_connections_total{cluster=~\"$cluster\", node_id=~\"$node_id\", result=~\"unauthorized|forbidden\"}[15m]))", "refId": "A"}], "gridPos": {"h": 4, "w": 6, "x": 0, "y": 64}},
      {"type": "timeseries", "title": "Rejected streams", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "sum by (protocol) (rate(tunnelmesh_streams_total{cluster=~\"$cluster\", node_id=~\"$node_id\", result=\"rejected\"}[5m]))", "refId": "A"}], "gridPos": {"h": 8, "w": 9, "x": 6, "y": 64}},
      {"type": "timeseries", "title": "Configuration reloads", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "sum by (result) (rate(tunnelmesh_config_reload_total{cluster=~\"$cluster\", node_id=~\"$node_id\"}[5m]))", "refId": "A"}], "gridPos": {"h": 8, "w": 9, "x": 15, "y": 64}},
      {"type": "timeseries", "title": "Heartbeat misses", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "sum by (component) (rate(tunnelmesh_heartbeat_total{cluster=~\"$cluster\", node_id=~\"$node_id\", result=~\"miss|timeout\"}[5m]))", "refId": "A"}], "gridPos": {"h": 8, "w": 12, "x": 0, "y": 72}},
      {"type": "table", "title": "Security anomalies", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "sum by (component, result, error_class) (increase(tunnelmesh_connections_total{cluster=~\"$cluster\", node_id=~\"$node_id\", result=~\"unauthorized|forbidden|error\"}[15m]))", "refId": "A", "format": "table"}], "gridPos": {"h": 8, "w": 12, "x": 12, "y": 72}}
    ]}
  ]
}
