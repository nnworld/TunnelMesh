global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/tunnelmesh/recording-rules.yaml
  - /etc/prometheus/tunnelmesh/alert-rules.yaml

scrape_configs:
  - job_name: tunnelmesh
    metrics_path: /metrics
    scheme: http
    static_configs:
      - targets: ["tunnelmesh-server:8080"]
        labels:
          cluster: local
